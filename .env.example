# Base de datos. En Neon: Dashboard > Connection string (con "Pooled connection" activado).
# Si la dejás vacía, en desarrollo la app usa una base local embebida (carpeta .data/), sin instalar nada.
DATABASE_URL=

# Secreto para firmar la cookie de sesión del dueño. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL pública de la app (para armar el QR y los links). Ej: https://turnos.webi.com.ar
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# TODO Fase 1.5: envío real de los códigos de login por mail (ej. Resend) .
# RESEND_API_KEY=
# MAIL_FROM=WEBI <no-responder@tudominio.com>
