# Base de datos. En Neon: Dashboard > Connection string (con "Pooled connection" activado).
# Si la dejás vacía, en desarrollo la app usa una base local embebida (carpeta .data/), sin instalar nada.
DATABASE_URL=

# Secreto para firmar la cookie de sesión del dueño. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL pública de la app (para armar el QR y los links). Ej: https://turnos.webi.com.ar
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Envío de los códigos de login por mail con Resend (resend.com). Sin dominio verificado, Resend solo deja mandar a tu propio mail.
RESEND_API_KEY=
MAIL_FROM=

# ---- Fase 2: Mercado Pago (una sola app de WEBI; cada local conecta su cuenta con OAuth) ----
# Mercado Pago Developers > Tus integraciones > Crear aplicación (Checkout Pro). Redirect URL: <NEXT_PUBLIC_BASE_URL>/api/mp/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Opcional pero recomendado: clave secreta de Webhooks de la aplicación (valida la firma de los avisos)
MP_WEBHOOK_SECRET=

# ---- Fase 2: WhatsApp Business Cloud API (un número de WEBI para todos los locales) ----
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Nombres de las plantillas aprobadas en Meta (defaults abajo)
# WA_TPL_CONFIRMACION=confirmacion_turno
# WA_TPL_RECORDATORIO=recordatorio_turno
# WA_TPL_CODIGO=codigo_login

# Protege /api/cron/recordatorios (Vercel lo manda solo como Bearer). Generá uno largo.
CRON_SECRET=
