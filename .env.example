# Base de datos. En Neon: Dashboard > Connection string (con "Pooled connection" activado).
# Si la dejás vacía, en desarrollo la app usa una base local embebida (carpeta .data/), sin instalar nada.
DATABASE_URL=

# Secreto para firmar la cookie de sesión del dueño. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL pública de la app (para armar el QR y los links). Ej: https://turnos.webi.com.ar
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Envío de los códigos de login/recuperación por mail. Elegí UNO. Orden de uso: SMTP > Brevo > Resend.
#
# OPCIÓN A (recomendada) · Gmail por SMTP, con "contraseña de aplicación" (gratis, ~500/día, buena entrega):
#   1) En la cuenta de Google: activá Verificación en 2 pasos.
#   2) myaccount.google.com/apppasswords > generá una (16 letras). Esa es SMTP_PASS (los espacios se ignoran).
#   3) MAIL_FROM tiene que ser la MISMA casilla de Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-casilla@gmail.com
SMTP_PASS=
#
# Respaldo opcional · Resend (necesita un dominio verificado): resend.com. Si usás Gmail SMTP, podés dejarlo vacío.
RESEND_API_KEY=
#
# Remitente que ven los clientes. Con Gmail SMTP, poné la misma casilla de SMTP_USER.
MAIL_FROM=WEBI Turnos <tu-casilla@gmail.com>

# ---- Fase 2: WhatsApp Business Cloud API (un número de WEBI para todos los locales) ----
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Nombres de las plantillas aprobadas en Meta (defaults abajo)
# WA_TPL_CONFIRMACION=confirmacion_turno
# WA_TPL_RECORDATORIO=recordatorio_turno
# WA_TPL_CODIGO=codigo_login

# Protege /api/cron/recordatorios (Vercel lo manda solo como Bearer). Generá uno largo.
CRON_SECRET=
